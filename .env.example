# Copy this file to `.env` and fill in your values.  DO NOT commit `.env` (it holds secrets).
#   cp .env.example .env

# ── Solace connector image ────────────────────────────────────────────────
# Obtain the File Connector image from Solace, then `docker load` / tag it and put the tag here.
MI_IMAGE=solace/solace-pubsub-connector-file:2.5.1

# ── Solace broker (Cloud or software) ─────────────────────────────────────
SOLACE_HOSTNAME=your-broker-host.messaging.solace.cloud   # bare host (compose builds tcps://host:55443)
SOLACE_VPN_NAME=your-message-vpn
SOLACE_CLIENT_USER=your-client-username
SOLACE_CLIENT_PWD=your-client-password
# Management (SEMP) — used only by broker/semp-setup.sh to create queues + subscriptions
SOLACE_SEMP_URL=https://your-broker-host.messaging.solace.cloud:943
SOLACE_MANAGEMENT_USER=your-mgmt-username
SOLACE_MANAGEMENT_PWD=your-mgmt-password

# ── Topics & queues (defaults are fine; keep source cfg + semp-setup in sync) ──
FC_BASE_TOPIC=solace/fc/source/demo
FC_SOURCE_LVQ=q.fc.source.lvq
FC_DEST_A_QUEUE=q.fc.dest-a
FC_DEST_B_QUEUE=q.fc.dest-b
FC_DEST_C_QUEUE=q.fc.dest-c

# ── SFTP destination servers (demo credentials, match config/sftp/dest.sftp.json) ──
FTP_USER=demo
FTP_PASSWORD=demo

# ── Google Cloud Storage source ───────────────────────────────────────────
GCS_PROJECT_ID=your-gcp-project-id
# Host path to the service-account JSON key (mounted read-only into fc-source).
# Relative to this docker-compose.yml, e.g. ./gcs-key.json
GCS_KEY_FILE=./gcs-key.json
